{
  "name": "uno-online",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @uno/client",
    "build": "npm run build -w @uno/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p packages/client --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
